# ==========================================
# MEETBOUND AGENCY — Environment Variables
# ==========================================
# Copy this file to .env.local for local dev
# Add these to Vercel dashboard for production

# ------------------------------------------
# DATABASE (required)
# ------------------------------------------
# Get this from https://neon.tech (free tier)
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql://..."

# ------------------------------------------
# EMAIL NOTIFICATIONS (optional)
# ------------------------------------------
# Get from https://resend.com (free: 100 emails/day)
RESEND_API_KEY="re_..."

# Email to receive new lead notifications
NOTIFY_EMAIL="hello@meetbound.agency"

# ------------------------------------------
# ADMIN API (required for blog management)
# ------------------------------------------
# Generate a random string: openssl rand -hex 32
# Use this key in the x-api-key header for POST/PATCH/DELETE
ADMIN_API_KEY="your-secret-admin-key-here"

# ------------------------------------------
# NEXT.JS (auto-set by Vercel)
# ------------------------------------------
NEXT_PUBLIC_SITE_URL="https://meetbound.agency"
